# ---- Base de datos ----
# Local (docker-compose): puerto 5433
DATABASE_URL="postgresql://clazz:clazz_dev_password@localhost:5433/clazz?schema=public"

# ---- Autenticación (Fase 1) ----
# Secretos para firmar JWT. En producción usar valores largos y aleatorios.
JWT_ACCESS_SECRET="cambia-esto-en-produccion-access"
JWT_REFRESH_SECRET="cambia-esto-en-produccion-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ---- Correo transaccional (Fase 1: OTP + notificaciones) ----
# Proyecto independiente: credenciales propias (Diego las proveerá).
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="Clazz <no-reply@clazz.example>"

# ---- Almacenamiento de archivos (MinIO / S3) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="clazz_minio"
S3_SECRET_KEY="clazz_minio_dev_password"
S3_BUCKET="clazz-uploads"
S3_FORCE_PATH_STYLE="true"

# ---- App ----
APP_URL="http://localhost:3000"
APP_NAME="Clazz"
